package userhandling

import (
	"github.com/mattthew/sclera/tempFrontend/shared"
)

templ LoginAccount() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8">
			<meta name="viewport" content="width=device-width, initial-scale=1.0">
			<title>Log in to Sclera</title>
			@shared.BaseStyles()
			<style>
				.submit-row { display: flex; gap: 12px; align-items: center; }
				.submit-row .btn { flex: 1; }
				.submit-row .hint { font-size: 13px; color: var(--text-muted); }

				.back-row {
					margin-top: 20px;
					text-align: center;
					font-size: 13px;
					color: var(--text-muted);
				}

				.back-row a { font-weight: 600; text-decoration: none; }
				.back-row a:hover { text-decoration: underline; }

				.forgot-wrap { text-align: center; margin-top: 18px; }

				#changePasswordForm {
					display: none;
					margin-top: 18px;
					padding-top: 18px;
					border-top: 1px solid var(--border);
				}
			</style>
		</head>
		<body>
			<div class="auth-shell">
				<main class="auth-card">
					<div class="brand-mark">
						<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</div>

					<h1 class="auth-title">Welcome back</h1>
					<p class="auth-sub">Log in with your email and password to keep chatting with Sclera.</p>

					<form action="/verifyLogin" method="POST" novalidate>
						<div class="field">
							<label class="field-label" for="email">Email</label>
							<input class="input" type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required>
						</div>

						<div class="field">
							<label class="field-label" for="password">Password</label>
							<input class="input" type="password" id="password" name="password" placeholder="Your password" autocomplete="current-password" required>
						</div>

						<button type="submit" class="btn">Log in</button>
					</form>

					<div class="forgot-wrap">
						<button type="button" class="link-btn" id="forgotBtn">Forgot your password?</button>
					</div>

					<form id="changePasswordForm" action="/sendVerificationMail" method="POST">
						<div class="field">
							<label class="field-label" for="resetEmail">Email</label>
							<input class="input" type="email" id="resetEmail" name="email" placeholder="Your account email" required>
						</div>
						<button type="submit" class="btn invert">Send OTP to my email</button>
					</form>

					<div class="hr"></div>

					<p class="back-row">No account yet? <a href="/newUser">Create one</a></p>
				</main>
			</div>

			<script>
				document.getElementById('forgotBtn').addEventListener('click', function () {
					const form = document.getElementById('changePasswordForm');
					const isHidden = form.style.display === 'none' || form.style.display === '';
					form.style.display = isHidden ? 'block' : 'none';
				});
			</script>
		</body>
	</html>
}