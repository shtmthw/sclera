package userhandling

import (
	"github.com/mattthew/sclera/tempFrontend/shared"
)

templ UpdatePassword() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8">
			<meta name="viewport" content="width=device-width, initial-scale=1.0">
			<title>Update Password</title>
			@shared.BaseStyles()
			<style>
				button:focus-visible,
				input:focus-visible {
					outline: 2px solid var(--accent);
					outline-offset: 2px;
				}
			</style>
		</head>
		<body>
			<div class="auth-shell">
				<main class="auth-card">
					<div class="brand-mark">
						<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M12 2L4 5v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V5l-8-3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
							<path d="M8.5 12l2.4 2.4L15.5 9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</div>

					<h1 class="auth-title">Set a new password</h1>
					<p class="auth-sub">Choose a new password for your account. Make sure both fields match.</p>

					<!-- Plain native form POST to /runPasswordUpdation, exactly as before.
					     The JS below only blocks the submit when the two fields differ. -->
					<form id="passwordForm" action="/runPasswordUpdation" method="POST" novalidate>
						<div class="field">
							<label class="field-label" for="newPassword">New password</label>
							<input class="input" type="password" id="newPassword" name="newPassword" autocomplete="new-password" required>
						</div>

						<div class="field">
							<label class="field-label" for="confirmPassword">Confirm new password</label>
							<input class="input" type="password" id="confirmPassword" name="password" autocomplete="new-password" required>
						</div>

						<div class="status" id="status">
							<span class="error-text" id="errorText">Passwords do not match.</span>
						</div>

						<button type="submit" class="btn">Update password</button>
					</form>
				</main>
			</div>

			<script>
				const form = document.getElementById('passwordForm');
				const newPassword = document.getElementById('newPassword');
				const confirmPassword = document.getElementById('confirmPassword');
				const statusEl = document.getElementById('status');
				const errorTextEl = document.getElementById('errorText');

				function showError(message) {
					errorTextEl.textContent = message;
					statusEl.classList.add('is-error');
					newPassword.classList.add('error');
					confirmPassword.classList.add('error');
				}

				function clearError() {
					statusEl.classList.remove('is-error');
					newPassword.classList.remove('error');
					confirmPassword.classList.remove('error');
				}

				newPassword.addEventListener('input', clearError);
				confirmPassword.addEventListener('input', clearError);

				form.addEventListener('submit', (e) => {
					if (newPassword.value !== confirmPassword.value) {
						e.preventDefault();
						showError('Passwords do not match.');
						confirmPassword.focus();
						return;
					}

					if (newPassword.value.length === 0) {
						e.preventDefault();
						showError('Password cannot be empty.');
						return;
					}
				});
			</script>
		</body>
	</html>
}