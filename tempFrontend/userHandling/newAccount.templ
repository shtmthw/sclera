package userhandling

import (
	"github.com/mattthew/sclera/tempFrontend/shared"
)

templ NewAccount() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8">
			<meta name="viewport" content="width=device-width, initial-scale=1.0">
			<title>Create your Sclera account</title>
			@shared.BaseStyles()
			<style>
				.auth-card { max-width: 480px; }

				.mono-note {
					font-size: 12px;
					color: var(--text-faint);
					margin-bottom: 18px;
				}

				.submit-row { display: flex; gap: 12px; align-items: center; }
				.submit-row .btn { flex: 1; }
				.submit-row .hint { font-size: 13px; color: var(--text-muted); }

				.back-row {
					margin-top: 20px;
					text-align: center;
					font-size: 13px;
					color: var(--text-muted);
				}

				.back-row a { font-weight: 600; text-decoration: none; }
				.back-row a:hover { text-decoration: underline; }
			</style>
		</head>
		<body>
			<div class="auth-shell">
				<main class="auth-card">
					<div class="brand-mark">
						<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</div>

					<h1 class="auth-title">Create your account</h1>
					<p class="auth-sub">Tell us a little about yourself and pick up to 5 topics you are interested in.</p>

					<form action="/createUser" method="POST" novalidate>
						<div class="field">
							<label class="field-label" for="name">Name</label>
							<input class="input" type="text" id="name" name="name" placeholder="Your name" autocomplete="name" required>
						</div>

						<div class="field">
							<label class="field-label" for="email">Email</label>
							<input class="input" type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required>
						</div>

						<div class="field">
							<label class="field-label" for="age">Age</label>
							<input class="input" type="number" id="age" name="age" placeholder="Your age" min="1" max="130" inputmode="numeric" required>
						</div>

						<div class="field">
							<label class="field-label" for="password">Password</label>
							<input class="input" type="password" id="password" name="password" placeholder="Choose a strong password" autocomplete="new-password" required>
						</div>

						<fieldset style="border: none; padding: 0; margin: 0 0 20px;">
							<legend class="field-label">Select up to 5 topics <span style="font-weight: 400;" id="topicCount"></span></legend>
							<p class="mono-note">Interests:
								Apple&nbsp;·&nbsp;Banana&nbsp;·&nbsp;Cherry&nbsp;·&nbsp;Date&nbsp;·&nbsp;Egg&nbsp;·&nbsp;Fig
							</p>
							<div class="chip-grid">
								<label class="chip">
									<input type="checkbox" name="items" value="apple">
									<span>Apple</span>
								</label>
								<label class="chip">
									<input type="checkbox" name="items" value="banana">
									<span>Banana</span>
								</label>
								<label class="chip">
									<input type="checkbox" name="items" value="cherry">
									<span>Cherry</span>
								</label>
								<label class="chip">
									<input type="checkbox" name="items" value="date">
									<span>Date</span>
								</label>
								<label class="chip">
									<input type="checkbox" name="items" value="egg">
									<span>Egg</span>
								</label>
								<label class="chip">
									<input type="checkbox" name="items" value="fig">
									<span>Fig</span>
								</label>
							</div>
						</fieldset>

						<button type="submit" class="btn">Create account</button>
					</form>

					<div class="hr"></div>

					<p class="back-row">Already have an account? <a href="/loginUser">Log in</a></p>
				</main>
			</div>

			<script>
				const checkboxes = document.querySelectorAll('input[name="items"]');
				const topicCountEl = document.getElementById('topicCount');

				function updateCheckboxLimit() {
					const checkedCount = document.querySelectorAll('input[name="items"]:checked').length;
					checkboxes.forEach(box => {
						box.disabled = checkedCount >= 5 && !box.checked;
					});
					topicCountEl.textContent = `(${checkedCount}/5)`;
				}

				checkboxes.forEach(cb => {
					cb.addEventListener('change', updateCheckboxLimit);
				});

				updateCheckboxLimit();
			</script>
		</body>
	</html>
}